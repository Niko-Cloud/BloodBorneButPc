+             '--output-res', os.environ.get('BB_OUTPUT_RES', ''),
+             '--patches-dir', os.environ.get('BB_PATCHES_DIR', data / 'patches'),
+             '--patches-config', os.environ.get('BB_PATCHES_CONFIG', data / 'patches.json')])
