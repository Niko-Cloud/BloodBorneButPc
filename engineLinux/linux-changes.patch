+/* The desktop mode of the primary display, in pixels (a scaled Wayland output reports its
+ * logical size with a pixel density). */
+static int display_size(void) {
+    if (!SDL_Init(SDL_INIT_VIDEO)) {
+        fprintf(stderr, "display size: %s\n", SDL_GetError());
+        return 1;
+    }
+    const SDL_DisplayMode *mode = SDL_GetDesktopDisplayMode(SDL_GetPrimaryDisplay());
+    int status = 1;
+    if (mode && mode->w > 0 && mode->h > 0) {
+        const float density = mode->pixel_density > 0 ? mode->pixel_density : 1.0f;
+        printf("%dx%d\n", (int)(mode->w * density + 0.5f), (int)(mode->h * density + 0.5f));
+        status = 0;
+    }
+    SDL_Quit();
+    return status;
+}
