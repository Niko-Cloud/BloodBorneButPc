index f783d21..66f4a59 100644
--- a/src/runtime_host.c
+++ b/src/runtime_host.c
@@ -143,7 +143,42 @@ void host_sleep_ns(uint64_t ns) {
 }
 #else
 #include <pthread.h>
+#include <stdio.h>
+#include <sys/resource.h>
 #include <time.h>
+#include <unistd.h>
+
+/* Linux schedules each thread by its own nice level, counted from the process's (a session or
+ * ananicy may start the game below 0 already). Going lower than the process needs RLIMIT_NICE
+ * (ulimit -e; 31 allows down to -11) or CAP_SYS_NICE: when the full step is refused the thread
+ * goes as far as the limit allows. */
+static int process_nice(void) {
+    static int base = 100;
+    if (base == 100) {
+        errno = 0;
+        const int nice = getpriority(PRIO_PROCESS, (id_t)getpid());
+        base = errno ? 0 : nice;
+    }
+    return base;
+}
+int host_thread_raise(int levels) {
+    const int base = process_nice();
+    int target = base - levels < -20 ? -20 : base - levels;
+    if (setpriority(PRIO_PROCESS, (id_t)gettid(), target) == 0) return levels > 0 ? 0 : -1;
+    if (levels <= 0) return -1;
+    struct rlimit limit;
+    if (getrlimit(RLIMIT_NICE, &limit) != 0 || limit.rlim_cur == RLIM_INFINITY) return -1;
+    target = 20 - (int)limit.rlim_cur; /* the lowest nice level the limit allows */
+    return target < base && setpriority(PRIO_PROCESS, (id_t)gettid(), target) == 0 ? 0 : -1;
+}
+/* 10 levels: well above the game's other threads, as Windows' THREAD_PRIORITY_HIGHEST. */
+void host_thread_set_high_priority(int high) {
+    if (host_thread_raise(high ? 10 : 0) != 0 && high) {
+        static int noted;
+        if (!__atomic_exchange_n(&noted, 1, __ATOMIC_RELAXED))
+            printf("Runtime: audio threads stay at normal priority: this system allows no higher one (ulimit -e)\n");
+    }
+}
 
 int host_thread_start(HostThread *thread, size_t stack, void *(*entry)(void *), void *argument) {
     pthread_attr_t attr;
