diff --git a/src/runtime_trophies.c b/src/runtime_trophies.c
new file mode 100644
index 0000000..5c7794a
--- /dev/null
+++ b/src/runtime_trophies.c
@@ -0,0 +1,141 @@
+/* Trophies the game unlocks (sceNpTrophyUnlockTrophy, runtime_services.c) and the ones a loaded
+ * save had already earned (gpu/shim/engine/trophy_sync.cpp) are kept in <user>/trophies.log, one
+ * "id unix-time" line each (the launcher's own format, launcher/windows/.../Core/Trophies.cs), so
+ * they count whoever started the game. An unlock also shows a desktop notification (notify-send)
+ * on Linux, unless BB_TROPHY_NOTIFY=0: the launcher sets it when it shows its own. */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "runtime.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#ifndef _WIN32
+#include <pthread.h>
+#include <spawn.h>
+#include <sys/wait.h>
+extern char **environ;
+#endif
+
+/* The game's trophy ids (TROP.SFM order), as Core/Trophies.cs names them. */
+static const struct { const char *name, *grade; } trophies[] = {
+    {"Bloodborne", "Platinum"}, /* 0 */
+    {"Yharnam Sunrise", "Gold"}, /* 1 */
+    {"Honoring Wishes", "Gold"}, /* 2 */
+    {"Childhood's Beginning", "Gold"}, /* 3 */
+    {"Yharnam, Pthumerian Queen", "Gold"}, /* 4 */
+    {"Hunter's Essence", "Gold"}, /* 5 */
+    {"Hunter's Craft", "Gold"}, /* 6 */
+    {"Weapon Master", "Silver"}, /* 7 */
+    {"Blood Gem Master", "Silver"}, /* 8 */
+    {"Rune Master", "Silver"}, /* 9 */
+    {"Cainhurst", "Silver"}, /* 10 */
+    {"The Choir", "Silver"}, /* 11 */
+    {"The Source of the Dream", "Silver"}, /* 12 */
+    {"Nightmare Lecture Building", "Silver"}, /* 13 */
+    {"Father Gascoigne", "Bronze"}, /* 14 */
+    {"Vicar Amelia", "Bronze"}, /* 15 */
+    {"Shadow of Yharnam", "Bronze"}, /* 16 */
+    {"Rom, the Vacuous Spider", "Bronze"}, /* 17 */
+    {"The One Reborn", "Bronze"}, /* 18 */
+    {"Micolash, Host of the Nightmare", "Bronze"}, /* 19 */
+    {"Mergo's Wet Nurse", "Bronze"}, /* 20 */
+    {"Cleric Beast", "Bronze"}, /* 21 */
+    {"Blood-starved Beast", "Bronze"}, /* 22 */
+    {"The Witch of Hemwick", "Bronze"}, /* 23 */
+    {"Darkbeast Paarl", "Bronze"}, /* 24 */
+    {"Amygdala", "Bronze"}, /* 25 */
+    {"Martyr Logarius", "Bronze"}, /* 26 */
+    {"Celestial Emissary", "Bronze"}, /* 27 */
+    {"Ebrietas, Daughter of the Cosmos", "Bronze"}, /* 28 */
+    {"Blood Gem Contact", "Bronze"}, /* 29 */
+    {"Rune Contact", "Bronze"}, /* 30 */
+    {"Chalice of Pthumeru", "Bronze"}, /* 31 */
+    {"Chalice of Ailing Loran", "Bronze"}, /* 32 */
+    {"Chalice of Isz", "Bronze"}, /* 33 */
+    {"Old Hunter's Essence", "Gold"}, /* 34 */
+    {"Orphan of Kos", "Silver"}, /* 35 */
+    {"Ludwig, the Holy Blade", "Bronze"}, /* 36 */
+    {"Lady Maria of the Astral Clocktower", "Bronze"}, /* 37 */
+    {"Living Failures", "Bronze"}, /* 38 */
+    {"Laurence, the First Vicar", "Bronze"}, /* 39 */
+};
+enum { TROPHY_COUNT = (int)(sizeof(trophies) / sizeof(trophies[0])) };
+
+static HostMutex lock = HOST_MUTEX_INIT;
+static int loaded;
+static unsigned char known[TROPHY_COUNT];
+
+static void log_path(char *path, size_t size) { snprintf(path, size, "%s/trophies.log", runtime_file_user_dir()); }
+
+/* The ids trophies.log already has (once, under the lock). */
+static void load_known(void) {
+    if (loaded) return;
+    loaded = 1;
+    char path[4096];
+    log_path(path, sizeof(path));
+    FILE *file = fopen(path, "r");
+    if (!file) return;
+    int id;
+    long long when;
+    char line[128];
+    while (fgets(line, sizeof(line), file))
+        if (sscanf(line, "%d %lld", &id, &when) == 2 && id >= 0 && id < TROPHY_COUNT) known[id] = 1;
+    fclose(file);
+}
+
+#ifndef _WIN32
+/* notify-send on a thread of its own, which waits for it: the game's thread never blocks on it
+ * and no finished process is left unreaped. */
+static void *notify_thread(void *arg) {
+    char *text = arg;
+    char *body = strchr(text, '\n');
+    if (body) *body++ = 0;
+    char *argv[] = {"notify-send", "--app-name=Bloodborne", "--icon=trophy-gold", "--expire-time=6000",
+                     text, body ? body : "", NULL};
+    pid_t pid;
+    if (posix_spawnp(&pid, "notify-send", NULL, NULL, argv, environ) == 0) {
+        int status;
+        waitpid(pid, &status, 0);
+    }
+    free(text);
+    return NULL;
+}
+
+static void notify(int id) {
+    const char *setting = getenv("BB_TROPHY_NOTIFY");
+    if (setting && !strcmp(setting, "0")) return;
+    char *text = malloc(256);
+    if (!text) return;
+    snprintf(text, 256, "%s (%s)\nYou have earned a trophy!", trophies[id].name, trophies[id].grade);
+    pthread_t thread;
+    pthread_attr_t attributes;
+    pthread_attr_init(&attributes);
+    pthread_attr_setdetachstate(&attributes, PTHREAD_CREATE_DETACHED);
+    if (pthread_create(&thread, &attributes, notify_thread, text) != 0) free(text);
+    pthread_attr_destroy(&attributes);
+}
+#endif
+
+void runtime_trophy_record(int id, int earned_in_save) {
+    if (id < 0 || id >= TROPHY_COUNT) return;
+    host_lock(&lock);
+    load_known();
+    const int fresh = !known[id];
+    if (fresh) {
+        known[id] = 1;
+        char path[4096];
+        log_path(path, sizeof(path));
+        FILE *file = fopen(path, "a");
+        if (file) {
+            fprintf(file, "%d %lld\n", id, (long long)time(NULL));
+            fclose(file);
+        }
+    }
+    host_unlock(&lock);
+#ifndef _WIN32
+    /* A save's earlier trophies are recorded quietly; a new unlock is announced once. */
+    if (fresh && !earned_in_save) notify(id);
+#endif
+}
