diff --git a/gpu/shim/bbport_platform.cpp b/gpu/shim/bbport_platform.cpp
index 52f794d..3ab0e14 100644
--- a/gpu/shim/bbport_platform.cpp
+++ b/gpu/shim/bbport_platform.cpp
@@ -145,3 +145,47 @@ unsigned CapSpinUs(unsigned wanted) {
 
 } // namespace BbThreads
 #endif
+
+#ifndef _WIN32
+#include "bbport_threads.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+// src/runtime_host.c: the calling thread `levels` above the process's nice level.
+extern "C" int host_thread_raise(int levels);
+
+namespace BbThreads {
+
+namespace {
+bool Raising() {
+    static const bool enabled = [] {
+        const char* env = std::getenv("BB_GPU_THREAD_PRIORITY");
+        return !(env && env[0] == '0');
+    }();
+    return enabled;
+}
+// The system refused a nice level below 0 (no RLIMIT_NICE, no CAP_SYS_NICE): the chain stays
+// normal, and spins are not capped for it.
+std::atomic<bool> g_refused{false};
+} // namespace
+
+// As on Windows (above): the game runs dozens of threads at normal priority, and a render-chain
+// thread queued behind them delays the frame. Five nice levels above them gives it about three
+// times their share of a busy core; its idle spins stay bounded.
+void MakeCritical(bool bulk) {
+    if (!Raising() || (bulk && Available() < 16)) {
+        return;
+    }
+    if (host_thread_raise(5) != 0 && !g_refused.exchange(true)) {
+        std::printf("GPU: render threads stay at normal priority: this system allows no higher one "
+                    "(ulimit -e; BB_GPU_THREAD_PRIORITY=0 skips trying)\n");
+    }
+}
+
+unsigned CapSpinUs(unsigned wanted) {
+    return Raising() && !g_refused.load(std::memory_order_relaxed) && Available() < 16 ? std::min(wanted, 50u) : wanted;
+}
+
+} // namespace BbThreads
+#endif
