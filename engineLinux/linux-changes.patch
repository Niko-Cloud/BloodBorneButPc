+namespace {
+
+/// The whole PC's CPU use since the last call, from /proc/stat's first line (idle and iowait
+/// count as idle).
+float CpuPercent() {
+    static std::uint64_t last_total = 0, last_idle = 0;
+    std::FILE* file = std::fopen("/proc/stat", "r");
+    if (!file) {
+        return -1.0f;
+    }
+    unsigned long long v[8] = {};
+    const int read = std::fscanf(file, "cpu %llu %llu %llu %llu %llu %llu %llu %llu", &v[0], &v[1], &v[2], &v[3],
+                                 &v[4], &v[5], &v[6], &v[7]);
+    std::fclose(file);
+    if (read < 4) {
+        return -1.0f;
+    }
+    std::uint64_t total = 0;
+    for (const auto value : v) {
+        total += value;
+    }
+    const std::uint64_t idle = v[3] + v[4];
+    const std::uint64_t dt = total - last_total, di = idle - last_idle;
+    const bool first = last_total == 0;
+    last_total = total;
+    last_idle = idle;
+    return first || dt == 0 ? -1.0f : 100.0f * static_cast<float>(dt - std::min(di, dt)) / static_cast<float>(dt);
+}
+
+/// The GPU's 3D use: amdgpu's gpu_busy_percent, or NVIDIA's NVML (the driver's
+/// libnvidia-ml.so.1, loaded when first asked); -1 for other GPUs (Intel has no such counter).
+class GpuCounter {
+public:
+    float Percent() {
+        if (!tried_) {
+            tried_ = true;
+            Open();
+        }
+        if (!amd_.empty()) {
+            std::FILE* file = std::fopen(amd_.c_str(), "r");
+            int busy = -1;
+            if (file) {
+                if (std::fscanf(file, "%d", &busy) != 1) busy = -1;
+                std::fclose(file);
+            }
+            return busy >= 0 ? static_cast<float>(busy) : -1.0f;
+        }
+        if (utilization_ && device_) {
+            Utilization use{};
+            return utilization_(device_, &use) == 0 ? static_cast<float>(use.gpu) : -1.0f;
+        }
+        return -1.0f;
+    }
+
+private:
+    struct Utilization {
+        unsigned gpu, memory;
+    };
+    using InitFn = int (*)();
+    using HandleFn = int (*)(unsigned, void**);
+    using UtilizationFn = int (*)(void*, Utilization*);
+
+    void Open() {
+        for (int card = 0; card < 8; ++card) {
+            const std::string path = "/sys/class/drm/card" + std::to_string(card) + "/device/gpu_busy_percent";
+            if (std::FILE* file = std::fopen(path.c_str(), "r")) {
+                std::fclose(file);
+                amd_ = path;
+                return;
+            }
+        }
+        void* nvml = dlopen("libnvidia-ml.so.1", RTLD_NOW | RTLD_LOCAL);
+        if (!nvml) {
+            return;
+        }
+        const auto init = reinterpret_cast<InitFn>(dlsym(nvml, "nvmlInit_v2"));
+        const auto handle = reinterpret_cast<HandleFn>(dlsym(nvml, "nvmlDeviceGetHandleByIndex_v2"));
+        const auto utilization = reinterpret_cast<UtilizationFn>(dlsym(nvml, "nvmlDeviceGetUtilizationRates"));
+        if (init && handle && utilization && init() == 0 && handle(0, &device_) == 0) {
+            utilization_ = utilization;
+        }
+    }
+
+    bool tried_ = false;
+    std::string amd_;
+    void* device_ = nullptr;
+    UtilizationFn utilization_ = nullptr;
+};
+
+} // namespace
+
+Sample Get(bool cpu, bool gpu) {
+    static Sample last;
+    static auto next = std::chrono::steady_clock::time_point{};
+    static GpuCounter counter;
+    const auto now = std::chrono::steady_clock::now();
+    if (now < next) {
+        return last;
+    }
+    next = now + std::chrono::milliseconds(500);
+    if (cpu) {
+        last.cpu = CpuPercent();
+    }
+    if (gpu) {
+        last.gpu = counter.Percent();
+    }
+    return last;
 }
 #endif
 
