<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Windows launcher's keyed styles (Themes/Styles.xaml and MainWindow.xaml) as classes:
        LauncherPage.Text(text, "Muted") adds the class "Muted".
    -->

    <!-- ==================== Text ==================== -->
    <Style Selector="TextBlock.GroupHeader">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="4,16,0,6" />
    </Style>
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.RowTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.Muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.Faint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.StatValue">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.StatLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Read-only monospaced output (the game's log). -->
    <Style Selector="TextBox.CodeBox">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PanelDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBox.CodeBox:pointerover /template/ Border#PART_BorderElement, TextBox.CodeBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PanelDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- A binding chip on the Controls page. -->
    <Style Selector="Border.Chip">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,2,6,2" />
    </Style>

    <!-- A flat, borderless button whose content is the whole look (binding cells, chips' x). -->
    <Style Selector="Button.BareButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.BareButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- ==================== Buttons (UiButton.Appearance) ==================== -->
    <Style Selector="Button.Transparent">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.Transparent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
    </Style>
    <Style Selector="Button.Danger">
        <Setter Property="Background" Value="#FFD64545" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFE25454" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.Danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFB83A3A" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- The tool bar's buttons (Play, Update, Activity). -->
    <Style Selector="Button.TitleIcon">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.TitleIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
    </Style>

    <!-- ==================== Navigation ==================== -->
    <!-- Modern: a top tab, a segment of the tab strip, filled when chosen. -->
    <Style Selector="RadioButton.Tab">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" Background="Transparent" CornerRadius="16" Padding="18,6" MinWidth="80">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.Tab:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.Tab:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.Tab:checked /template/ Border#Bg">
        <Setter Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
    </Style>
    <Style Selector="RadioButton.Tab:checked">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Classic: a source-list sidebar row. -->
    <Style Selector="RadioButton.Side">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.Side:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.Side:pointerover, RadioButton.Side:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.Side:checked /template/ Border#Bg">
        <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
    </Style>
    <Style Selector="TextBlock.SidebarHeader">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderBrush}" />
        <Setter Property="Margin" Value="18,0,0,6" />
    </Style>

    <!-- Every tool tip in the launcher's dialog colours. -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource DialogBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DialogStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

</Styles>
