<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Charcoal surfaces, as the Windows launcher's Themes/Charcoal.xaml: neutral greys stepped a
        few shades apart (window, sidebar, content, card), hairline borders, and one accent for
        anything interactive. The Fluent theme's own keys at the end recolour its controls to match.
    -->

    <!-- ==================== Window ==================== -->
    <SolidColorBrush x:Key="WindowBaseBrush" Color="#FF242426" />
    <SolidColorBrush x:Key="ContentAreaBrush" Color="#FF29292B" />

    <!-- ==================== Surfaces ==================== -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF3A3A3E" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF303034" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF38383C" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF1E1E21" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF3C3C41" />

    <!-- Dense text surfaces (the game output, the activity log): darker than a card. -->
    <SolidColorBrush x:Key="PanelDeepBrush" Color="#FF1E1E20" />

    <!-- Dialogs: an opaque card over a dimmed window, so nothing behind shows through. -->
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF2C2C2F" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#FF3E3E43" />

    <!-- Sidebar rows -->
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#FF37373B" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#FF67676D" />

    <!-- ==================== Text & accent ==================== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE6E6E8" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA8A8AD" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7C7C82" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF4C9DFF" />
    <SolidColorBrush x:Key="StatusDotIdleBrush" Color="#FF6E6E74" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFF2B84B" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="GoodTextBrush" Color="#FF5FD38A" />
    <!-- The chosen option of a segmented control and the active tab. -->
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FF2D7FF0" />

    <!-- Pane, divider and pill colours; Glass.axaml turns them into glass for the Modern layout. -->
    <SolidColorBrush x:Key="GlassPaneBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="GlassPaneStrokeBrush" Color="#FF3A3A3E" />
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#FF3A3A3E" />
    <SolidColorBrush x:Key="PillTrackBrush" Color="#FF1E1E21" />

    <FontFamily x:Key="MonoFont">Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>

    <!-- ==================== The Fluent theme's controls ==================== -->
    <Color x:Key="SystemAccentColor">#FF2D7FF0</Color>
    <Color x:Key="SystemAccentColorDark1">#FF2470D8</Color>
    <Color x:Key="SystemAccentColorDark2">#FF1E62C0</Color>
    <Color x:Key="SystemAccentColorLight1">#FF4C9DFF</Color>
    <Color x:Key="SystemAccentColorLight2">#FF6BAEFF</Color>
    <Color x:Key="SystemAccentColorLight3">#FF8ABFFF</Color>
    <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillColorSecondaryBrush" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF424247" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF333337" />
    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
    <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillColorInputActiveBrush" />
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
    <StaticResource x:Key="ComboBoxBackground" ResourceKey="ControlFillColorSecondaryBrush" />
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2C2C2F" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF2C2C2F" />
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

</ResourceDictionary>
